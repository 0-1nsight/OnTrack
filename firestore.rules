rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidPreferences(prefs) {
      return prefs is map &&
        prefs.keys().hasAll(['idleThresholdSeconds', 'workdayStartHour', 'workdayEndHour', 'darkMode', 'autoPauseOnIdle']) &&
        prefs.keys().hasOnly(['idleThresholdSeconds', 'workdayStartHour', 'workdayEndHour', 'darkMode', 'autoPauseOnIdle']) &&
        prefs.idleThresholdSeconds is number && prefs.idleThresholdSeconds >= 15 && prefs.idleThresholdSeconds <= 3600 &&
        prefs.workdayStartHour is number && prefs.workdayStartHour >= 0 && prefs.workdayStartHour <= 23 &&
        prefs.workdayEndHour is number && prefs.workdayEndHour >= 1 && prefs.workdayEndHour <= 24 &&
        prefs.darkMode is bool &&
        prefs.autoPauseOnIdle is bool;
    }

    function isValidMetricsSnapshot(snap) {
      return snap is map &&
        snap.keys().hasAll([
          'totalMinutes', 'totalHours', 'plannedMinutes', 'plannedHours',
          'deepWorkMinutes', 'deepWorkPercent', 'billableMinutes', 'billablePercent',
          'completedCount', 'totalTasksCount', 'completionRate', 'estimationAccuracyPercent'
        ]) &&
        snap.keys().hasOnly([
          'totalMinutes', 'totalHours', 'plannedMinutes', 'plannedHours',
          'deepWorkMinutes', 'deepWorkPercent', 'billableMinutes', 'billablePercent',
          'completedCount', 'totalTasksCount', 'completionRate', 'estimationAccuracyPercent'
        ]) &&
        snap.totalMinutes is number &&
        snap.totalHours is number &&
        snap.plannedMinutes is number &&
        snap.plannedHours is number &&
        snap.deepWorkMinutes is number &&
        snap.deepWorkPercent is number &&
        snap.billableMinutes is number &&
        snap.billablePercent is number &&
        snap.completedCount is number &&
        snap.totalTasksCount is number &&
        snap.completionRate is number &&
        snap.estimationAccuracyPercent is number;
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['ownerId', 'email', 'displayName', 'preferences', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'displayName', 'jobTitle', 'photoURL', 'hourlyRate', 'currency', 'preferences', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('hourlyRate' in data) || (data.hourlyRate is number && data.hourlyRate >= 0 && data.hourlyRate <= 100000)) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 8)) &&
        isValidPreferences(data.preferences) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'description', 'project', 'status', 'priority', 'category', 'tags', 'estimatedMinutes', 'subtasks', 'createdDate', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'description', 'project', 'status', 'priority', 'category', 'tags', 'estimatedMinutes', 'blockerNote', 'subtasks', 'createdDate', 'startDate', 'dueDate', 'completedDate', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.description is string && data.description.size() <= 2000 &&
        data.project is string && data.project.size() >= 1 && data.project.size() <= 80 &&
        data.status in ['in_progress', 'todo', 'blocked', 'completed'] &&
        data.priority in ['urgent', 'high', 'medium', 'low'] &&
        data.category in ['deep_work', 'collaborative', 'billable', 'admin'] &&
        data.tags is list && data.tags.size() <= 20 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 50)) &&
        data.estimatedMinutes is number && data.estimatedMinutes >= 0 && data.estimatedMinutes <= 10080 &&
        (!('blockerNote' in data) || (data.blockerNote is string && data.blockerNote.size() <= 1000)) &&
        data.subtasks is list && data.subtasks.size() <= 30 && (data.subtasks.size() == 0 || data.subtasks[0] is map) &&
        data.createdDate is string && data.createdDate.size() <= 20 &&
        (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 20)) &&
        (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 20)) &&
        (!('completedDate' in data) || (data.completedDate is string && data.completedDate.size() <= 20)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTimeBlock(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'project', 'category', 'tags', 'date', 'startTime', 'endTime', 'durationMinutes', 'source', 'isBillable', 'notes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'taskId', 'title', 'project', 'category', 'tags', 'date', 'startTime', 'endTime', 'durationMinutes', 'source', 'isBillable', 'notes', 'appName', 'documentTitle', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        (!('taskId' in data) || data.taskId == null || isValidId(data.taskId)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.project is string && data.project.size() >= 1 && data.project.size() <= 80 &&
        data.category in ['deep_work', 'collaborative', 'billable', 'admin'] &&
        data.tags is list && data.tags.size() <= 20 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 50)) &&
        isValidDateStr(data.date) &&
        data.startTime is number && data.startTime >= 0 && data.startTime <= 1440 &&
        data.endTime is number && data.endTime >= 0 && data.endTime <= 1440 && data.endTime >= data.startTime &&
        data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 1440 &&
        data.source in ['timer', 'manual', 'reconciled'] &&
        data.isBillable is bool &&
        data.notes is string && data.notes.size() <= 1000 &&
        (!('appName' in data) || (data.appName is string && data.appName.size() <= 80)) &&
        (!('documentTitle' in data) || (data.documentTitle is string && data.documentTitle.size() <= 250)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidActivitySegment(data) {
      return data.keys().hasAll(['id', 'ownerId', 'date', 'startTime', 'endTime', 'state', 'label', 'reconciled', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'date', 'startTime', 'endTime', 'state', 'label', 'reconciled', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidDateStr(data.date) &&
        data.startTime is number && data.startTime >= 0 && data.startTime <= 1440 &&
        data.endTime is number && data.endTime >= 0 && data.endTime <= 1440 && data.endTime >= data.startTime &&
        data.state in ['active', 'idle', 'away'] &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 200 &&
        data.reconciled is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAppSegment(data) {
      return data.keys().hasAll(['id', 'ownerId', 'date', 'startTime', 'endTime', 'appName', 'appCategory', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'date', 'startTime', 'endTime', 'appName', 'appCategory', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidDateStr(data.date) &&
        data.startTime is number && data.startTime >= 0 && data.startTime <= 1440 &&
        data.endTime is number && data.endTime >= 0 && data.endTime <= 1440 && data.endTime >= data.startTime &&
        data.appName is string && data.appName.size() >= 1 && data.appName.size() <= 80 &&
        data.appCategory in ['code', 'browser', 'design', 'comms', 'docs'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDocSegment(data) {
      return data.keys().hasAll(['id', 'ownerId', 'date', 'startTime', 'endTime', 'appName', 'documentTitle', 'domainOrPath', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'date', 'startTime', 'endTime', 'appName', 'documentTitle', 'domainOrPath', 'linkedTaskId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidDateStr(data.date) &&
        data.startTime is number && data.startTime >= 0 && data.startTime <= 1440 &&
        data.endTime is number && data.endTime >= 0 && data.endTime <= 1440 && data.endTime >= data.startTime &&
        data.appName is string && data.appName.size() >= 1 && data.appName.size() <= 80 &&
        data.documentTitle is string && data.documentTitle.size() >= 1 && data.documentTitle.size() <= 250 &&
        data.domainOrPath is string && data.domainOrPath.size() <= 250 &&
        (!('linkedTaskId' in data) || data.linkedTaskId == null || isValidId(data.linkedTaskId)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWeeklyReport(data) {
      return data.keys().hasAll(['id', 'ownerId', 'weekStartDate', 'weekEndDate', 'generatedAt', 'tone', 'executiveSummary', 'accomplishments', 'blockersAndRisks', 'velocityInsights', 'nextWeekFocus', 'metricsSnapshot', 'isAiGenerated', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'weekStartDate', 'weekEndDate', 'generatedAt', 'tone', 'executiveSummary', 'accomplishments', 'blockersAndRisks', 'velocityInsights', 'nextWeekFocus', 'metricsSnapshot', 'isAiGenerated', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.weekStartDate is string && data.weekStartDate.size() <= 20 &&
        data.weekEndDate is string && data.weekEndDate.size() <= 20 &&
        data.generatedAt is string && data.generatedAt.size() <= 40 &&
        data.tone in ['executive', 'standup', 'client'] &&
        data.executiveSummary is string && data.executiveSummary.size() >= 1 && data.executiveSummary.size() <= 4000 &&
        data.accomplishments is list && data.accomplishments.size() <= 20 && (data.accomplishments.size() == 0 || data.accomplishments[0] is string) &&
        data.blockersAndRisks is list && data.blockersAndRisks.size() <= 20 && (data.blockersAndRisks.size() == 0 || data.blockersAndRisks[0] is string) &&
        data.velocityInsights is string && data.velocityInsights.size() <= 2000 &&
        data.nextWeekFocus is list && data.nextWeekFocus.size() <= 20 && (data.nextWeekFocus.size() == 0 || data.nextWeekFocus[0] is string) &&
        isValidMetricsSnapshot(data.metricsSnapshot) &&
        data.isAiGenerated is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. User Account Profile & Private Workspace Collections
    match /users/{userId} {
      allow list: if false;
      allow get: if isValidId(userId) && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'jobTitle', 'photoURL', 'hourlyRate', 'currency', 'preferences', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['preferences', 'updatedAt'])
        );
      allow delete: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;

      match /tasks/{taskId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(taskId) && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
        allow create: if isOwner(userId) &&
          isValidId(taskId) &&
          isValidTask(incoming()) &&
          incoming().id == taskId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) &&
          isValidId(taskId) &&
          isValidTask(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedDate', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['subtasks', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['startDate', 'dueDate', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'project', 'status', 'priority', 'category', 'tags', 'estimatedMinutes', 'blockerNote', 'subtasks', 'startDate', 'dueDate', 'completedDate', 'updatedAt'])
          );
        allow delete: if isValidId(taskId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }

      match /timeBlocks/{blockId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(blockId) && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
        allow create: if isOwner(userId) &&
          isValidId(blockId) &&
          isValidTimeBlock(incoming()) &&
          incoming().id == blockId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) &&
          isValidId(blockId) &&
          isValidTimeBlock(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['taskId', 'title', 'project', 'category', 'tags', 'date', 'startTime', 'endTime', 'durationMinutes', 'source', 'isBillable', 'notes', 'appName', 'documentTitle', 'updatedAt']);
        allow delete: if isValidId(blockId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }

      match /activitySegments/{segmentId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(segmentId) && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
        allow create: if isOwner(userId) &&
          isValidId(segmentId) &&
          isValidActivitySegment(incoming()) &&
          incoming().id == segmentId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) &&
          isValidId(segmentId) &&
          isValidActivitySegment(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['state', 'label', 'reconciled', 'updatedAt']);
        allow delete: if isValidId(segmentId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }

      match /appSegments/{appSegmentId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(appSegmentId) && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
        allow create: if isOwner(userId) &&
          isValidId(appSegmentId) &&
          isValidAppSegment(incoming()) &&
          incoming().id == appSegmentId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) &&
          isValidId(appSegmentId) &&
          isValidAppSegment(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['startTime', 'endTime', 'appName', 'appCategory', 'updatedAt']);
        allow delete: if isValidId(appSegmentId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }

      match /documentSegments/{docSegmentId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(docSegmentId) && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
        allow create: if isOwner(userId) &&
          isValidId(docSegmentId) &&
          isValidDocSegment(incoming()) &&
          incoming().id == docSegmentId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) &&
          isValidId(docSegmentId) &&
          isValidDocSegment(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['linkedTaskId', 'documentTitle', 'appName', 'updatedAt']);
        allow delete: if isValidId(docSegmentId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }

      match /reports/{reportId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(reportId) && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
        allow create: if isOwner(userId) &&
          isValidId(reportId) &&
          isValidWeeklyReport(incoming()) &&
          incoming().id == reportId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) &&
          isValidId(reportId) &&
          isValidWeeklyReport(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['executiveSummary', 'accomplishments', 'blockersAndRisks', 'velocityInsights', 'nextWeekFocus', 'updatedAt']);
        allow delete: if isValidId(reportId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }
    }
  }
}
