# Server & Deployment
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Session & Crypto Secrets (generate strong 32+ byte secrets in production)
SESSION_SECRET=""
ENCRYPTION_KEY=""
COOKIE_SECURE="auto"

# Demo Sandbox (MUST be false or unset in production)
DEMO_MODE="true"

# First-Run Admin Bootstrap (optional; if unset in fresh DB, use first-run setup UI)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_TENANT_NAME="Apex Chartered Accountants"

# Database (PostgreSQL recommended for production; leave empty for local SQLite dev/tests)
DATABASE_URL=""
DATA_DIR="./data"

# Email (SMTP for invites, password resets, and IT/Client notifications; optional in dev)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="OnTrack <noreply@ontrack.local>"

# Optional CORS allowed origins (comma-separated)
CORS_ORIGINS=""

# Optional Server-Side AI Reports (off by default per tenant; aggregate numbers only)
GEMINI_API_KEY=""
AI_REPORTS_GLOBAL_ALLOW="false"
